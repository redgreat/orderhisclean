# 定时任务配置
scheduler:
  # 每天开始执行的时间
  start_time: "01:00"
  # 处理器模块列表 (不需要添加src.前缀，程序会自动处理)
  handler_modules:
    - "delete_resource_handler"
    - "delete_workflow_handler"
    - "migration_handler"
    - "workflow_complete_migration_handler"

# 数据库连接配置
database:
  # 源数据库配置
  source:
    host: "127.0.0.1"
    port: 3306
    database: "source_db"  # 可用逗号分隔多个数据库
    tables: "order_history,other_table"  # 可用逗号分隔多个表
    user: "root"
    password: "password"
    charset: "utf8"
  
  # 目标数据库配置
  target:
    host: "127.0.0.1"
    port: 3306
    database: "target_db"
    user: "root"
    password: "password"
    charset: "utf8"

# 处理器配置
handlers:
  # 删除处理器配置
  delete_resource_handler:
    table: "order_history"
    where_clause: "created_at < DATE_SUB(NOW(), INTERVAL 180 DAY)"
    batch_size: 5000
    cut_off_time: "23:00:00"  # 每天截止时间，格式: HH:MM:SS
  
  # 工作流删除处理器配置
  delete_workflow_handler:
    batch_size: 100
    cut_off_time: "23:00:00"  # 每天截止时间，格式: HH:MM:SS

  # 数据迁移处理器配置
  migration_handler:
    source_table: "source_table_name"
    target_table: "target_table_name"
    where_clause: "status = 'COMPLETED' AND created_at < DATE_SUB(NOW(), INTERVAL 90 DAY)"
    batch_size: 3000
    cut_off_time: "22:30:00"  # 每天截止时间，格式: HH:MM:SS

  # 工作流运行时数据按年迁移到完成时表 (源库需为 serviceordercenter)
  # 按 tb_workorderinfo.CreatedAt 年份区间 [Y-01-01, Y+1-01-01) 筛选工单主单，
  # 再迁移其 workflowruntime* 数据到 workflowcomplete*，每批同一事务内插入后删除运行时数据
  workflowcompletemigrationhandler:
    enabled: false  # 是否启用（false 则跳过，所有处理器都支持该开关）
    years: []  # 需要迁移的年份列表（按顺序执行），例如: [2022, 2023]；为空则不执行
    batch_size: 50  # 每批工单项数量（性能打满时可调大）
    pause_seconds: 30  # 每批之间等待秒数（后台常驻时可调大）
    workers: 1  # 并发线程数，按 Id 哈希分片互不冲突（性能打满时调大，后台常驻建议 1）
    cut_off_time: "23:00:00"  # 每天截止时间，格式: HH:MM:SS

# 日志配置
logging:
  # 日志目录（相对于项目根目录）
  dir: "log"
  # 日志文件名
  filename: "batch_jobs.log"
  # 日志级别
  level: "INFO"
  # 日志保留天数
  retention: "7 days"
  # 日志轮转策略
  rotation: "1 days"
  # 是否启用彩色输出
  colorize: true
  # 是否启用诊断信息
  diagnose: true
  # 是否启用回溯
  backtrace: true
  # 日志格式
  format: "{time:YYYY-MM-DD at HH:mm:ss} | {level} | {message}"
